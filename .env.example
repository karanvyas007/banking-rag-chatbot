# Copy to .env and fill in. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Models
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Fixed per index; changing the model or dimension requires: python -m backend.ingestion --reset
EMBEDDING_DIMENSION=3072

# Vector store
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION=banking_docs

# Source documents for ingestion
DOCS_DIR=data/raw

# Retrieval: passages per question, and minimum cosine relevance (0-1) to use a passage
RETRIEVAL_TOP_K=4
MIN_RELEVANCE=0.65

# Frontend -> backend
BACKEND_URL=http://localhost:8000
